{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polos",
  "version": "0.1.0",
  "identifier": "com.polos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "婴儿头型测量系统",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "婴儿头型数据记录与跟踪系统",
    "longDescription": "用于医院内部的离线桌面端应用程序，用于记录、跟踪与分析婴儿头型数据",
    "windows": {
      "digestAlgorithm": "sha256"
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:polos.db"
      ]
    }
  }
}